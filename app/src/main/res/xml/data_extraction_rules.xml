<?xml version="1.0" encoding="utf-8"?>
<!-- JWT가 저장되는 앱 데이터(DataStore 등)를 클라우드 백업·기기 이전에서 제외한다 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
